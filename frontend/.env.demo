# Standalone demo mode - loaded by `npm run demo` and `npm run build:demo`.
#
# This file is committed deliberately and holds no secrets. It is the switch
# that makes the app answer its own API calls from in-memory fixtures, so the
# whole UI can be demonstrated with no backend running.
#
# Keep this flag out of .env, .env.local and .env.production: it must never be
# possible to reach demo mode on a real deployment.

VITE_DEMO_MODE=true

# In demo mode the dev-server proxy is irrelevant because no request ever leaves
# the browser, but the variable still has to exist so the Vite config does not
# fall back to localhost:8080 and print a connection error.
VITE_BACKEND_ORIGIN=unreachable-in-demo-mode
