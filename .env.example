# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored - never commit it.
#
#   cp .env.example .env      (Windows: copy .env.example .env)
# ---------------------------------------------------------------------------

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/loan_management_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
# CHANGE THIS. The old value was committed to a public repo and must be rotated.
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080
SESSION_TIMEOUT=30m

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Bootstrap admin (created on first run if no ADMIN user exists) ---
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
# CHANGE THIS. Minimum 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo dataset ---
# Seeds 100 customers + logins + loans in a single transaction. Every demo login
# shares the password DemoCustomer!2026, so leave this OFF anywhere real.
# See docs/sample-data-records.md for the generated inventory of what it creates.
SAMPLE_DATA_ENABLED=true
SAMPLE_DATA_CUSTOMERS=100
